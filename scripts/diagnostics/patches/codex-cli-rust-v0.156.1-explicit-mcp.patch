@@ -853,0 +854,27 @@ impl CodexThread {
+    /// Bind the explicit human MCP input opt-in to the current owning client.
+    /// A missing or false capability clears any prior opt-in on a loaded thread.
+    pub async fn set_explicit_mcp_elicitation_from_client(&self, extensions: &ClientMcpExtensions) {
+        let source = self.config_snapshot().await.thread_source;
+        let (form, url) = if self.session_source.is_non_root_agent()
+            || !matches!(source, None | Some(ThreadSource::User))
+        {
+            (false, false)
+        } else {
+            extensions.explicit_mcp_elicitation_modes()
+        };
+        self.session
+            .services
+            .mcp_runtime
+            .enable_explicit_mcp_elicitation(form, url);
+    }
+
+    /// A warm rejoin may only remove modes from an active thread. Enabling a
+    /// mode waits for the next authorized direct-input turn.
+    pub fn restrict_explicit_mcp_elicitation_from_client(&self, extensions: &ClientMcpExtensions) {
+        let (form, url) = extensions.explicit_mcp_elicitation_modes();
+        self.session
+            .services
+            .mcp_runtime
+            .restrict_explicit_mcp_elicitation(form, url);
+    }
+
