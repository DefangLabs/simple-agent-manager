--- a/src/__tests__/PermissionLifecycleContext.test.ts
+++ b/src/__tests__/PermissionLifecycleContext.test.ts
@@ -210,0 +211,41 @@ describe("PermissionLifecycleContext", () => {
+    it("requires matching live URL ownership and never infers completion from request resolution", async () => {
+        const prompt = new PermissionLifecycleContext(sessionState()).beginPrompt();
+        const connection = {
+            request: vi.fn().mockResolvedValue({action: "accept"}),
+            notify: vi.fn().mockResolvedValue(undefined),
+        } as unknown as AcpClientConnection;
+        const abort = new AbortController();
+        const seen = new Set<string>();
+        let current = true;
+        const handler = new CodexElicitationHandler(connection, prompt,
+            {elicitation: {url: {}}}, abort.signal, () => current, seen);
+        const request = {
+            threadId: "session", originThreadId: "child-a", turnId: "turn-a",
+            serverName: "server-a", mode: "url" as const, _meta: null,
+            message: "Authorize", url: "https://example.test/authorize", elicitationId: "id-a",
+        };
+        expect(await handler.handleElicitation(request)).toMatchObject({action: "accept"});
+        await handler.handleNotification({method: "serverRequest/resolved", params: {threadId: "session", requestId: 1}} as never);
+        for (const [originThreadId, serverName, elicitationId] of [
+            ["child-b", "server-a", "id-a"], ["child-a", "server-b", "id-a"],
+            ["child-a", "server-a", "unknown"],
+        ] as Array<[string, string, string]>) {
+            await handler.handleNotification({method: "mcpServer/elicitation/completed",
+                params: {threadId: "session", originThreadId, serverName, elicitationId}});
+        }
+        expect(connection.notify).not.toHaveBeenCalled();
+        await handler.handleNotification({method: "mcpServer/elicitation/completed",
+            params: {threadId: "session", originThreadId: "child-a", serverName: "server-a", elicitationId: "id-a"}});
+        await handler.handleNotification({method: "mcpServer/elicitation/completed",
+            params: {threadId: "session", originThreadId: "child-a", serverName: "server-a", elicitationId: "id-a"}});
+        expect(connection.notify).toHaveBeenCalledTimes(1);
+        current = false;
+        expect(await handler.handleElicitation({...request, elicitationId: "id-b"})).toMatchObject({action: "cancel"});
+        const next = new CodexElicitationHandler(connection, prompt,
+            {elicitation: {url: {}}}, undefined, () => true, seen);
+        expect(await next.handleElicitation(request)).toMatchObject({action: "cancel"});
+        expect(connection.request).toHaveBeenCalledTimes(1);
+        abort.abort();
+        next.dispose();
+    });
+
