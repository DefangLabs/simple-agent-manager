diff --git a/src/__tests__/CodexACPAgent/CodexAcpClient.test.ts b/src/__tests__/CodexACPAgent/CodexAcpClient.test.ts
index d1e27ae..fd2b736 100644
--- a/src/__tests__/CodexACPAgent/CodexAcpClient.test.ts
+++ b/src/__tests__/CodexACPAgent/CodexAcpClient.test.ts
@@ -23,0 +24,19 @@ describe('ACP server test', { timeout: 40_000 }, () => {
+    it('forwards only negotiated MCP input modes to app-server initialize', async () => {
+        const enabled = createTestFixture();
+        const enabledInitialize = vi.spyOn(enabled.getCodexAcpClient().appServerClient, 'initialize');
+        await enabled.getCodexAcpAgent().initialize({
+            protocolVersion: 1,
+            clientCapabilities: { elicitation: { form: {}, url: {} } },
+        });
+        expect(enabledInitialize).toHaveBeenCalledWith(expect.objectContaining({
+            capabilities: expect.objectContaining({
+                extensions: { 'sam/acp-explicit-elicitation': { form: true, url: true } },
+            }),
+        }));
+
+        const disabled = createTestFixture();
+        const disabledInitialize = vi.spyOn(disabled.getCodexAcpClient().appServerClient, 'initialize');
+        await disabled.getCodexAcpAgent().initialize({ protocolVersion: 1 });
+        expect(disabledInitialize.mock.calls[0]?.[0].capabilities?.extensions).toBeUndefined();
+    });
+
